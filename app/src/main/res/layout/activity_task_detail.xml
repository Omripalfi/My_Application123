<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:layoutDirection="rtl">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#212121"
        android:gravity="center"
        android:text="פרטי משימה"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="כותרת משימה"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvDetailType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="סוג: שיעורי בית"
            android:textColor="#000000"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvDetailSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="מקצוע: מתמטיקה"
            android:textColor="#000000"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvDetailPriority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="עדיפות: גבוהה"
            android:textColor="#000000"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvDetailDueDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="תאריך הגשה: 12/10"
            android:textColor="#000000"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvDetailAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="תרגילים: 8"
            android:textColor="#000000"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvDetailStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="סטטוס: טרם בוצע"
            android:textColor="#000000"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvDetailPoints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="שווה 0 נקודות"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="30dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnToggleDone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#D6D6D6"
            android:text="סמן כבוצע"
            android:textColor="#000000"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#D6D6D6"
                android:text="חזרה"
                android:textColor="#000000"
                android:textSize="17sp" />

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="#D6D6D6"
                android:text="מחיקה"
                android:textColor="#000000"
                android:textSize="17sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
